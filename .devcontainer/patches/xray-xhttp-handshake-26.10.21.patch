+// VLESS uses this per-stream guard because HTTP request bodies are not raw
+// sockets. Never set a handshake deadline on their shared HTTP/2 carrier.
+func (c *splitConn) StartHandshakeTimeout(timeout time.Duration) func() {
+	finished := make(chan struct{})
+	timer := time.AfterFunc(timeout, func() {
+		defer close(finished)
+		_ = c.Close()
+	})
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			if !timer.Stop() {
+				<-finished
+			}
+		})
+	}
+}
