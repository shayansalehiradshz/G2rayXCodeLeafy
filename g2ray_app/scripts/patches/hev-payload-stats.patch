 void hev_socks5_tunnel_update_session (HevListNode *node);
 
+void hev_socks5_tunnel_add_tcp_payload (size_t bytes);
+unsigned long long hev_socks5_tunnel_tcp_payload_stats (void);
+
 #endif /* __HEV_SOCKS5_TUNNEL_H__ */
