diff --git a/src/hev-socks5-tunnel.c b/src/hev-socks5-tunnel.c
--- a/src/hev-socks5-tunnel.c
+++ b/src/hev-socks5-tunnel.c
@@ -59,7 +59,8 @@
 static size_t stat_tx_packets;
 static size_t stat_rx_packets;
 static size_t stat_tx_bytes;
 static size_t stat_rx_bytes;
+static atomic_ullong stat_rx_tcp_payload_bytes;
 
 static struct netif *netif;
 static struct tcp_pcb *tcp;
@@ -516,10 +517,18 @@
         udp = NULL;
     }
+    /* SYN_RCVD PCBs have no HEV session yet. Drain them before lwIP's
+     * memory pools are reinitialized on the next Android service start. */
+    while (tcp_active_pcbs)
+        tcp_abort (tcp_active_pcbs);
+    while (tcp_tw_pcbs)
+        tcp_abort (tcp_tw_pcbs);
     if (tcp) {
         tcp_close (tcp);
         tcp = NULL;
     }
+    while (tcp_bound_pcbs)
+        tcp_abort (tcp_bound_pcbs);
     if (netif) {
         netif_remove (netif);
         netif = NULL;
@@ -715,7 +716,8 @@
     stat_tx_packets = 0;
     stat_rx_packets = 0;
     stat_tx_bytes = 0;
     stat_rx_bytes = 0;
+    atomic_store_explicit (&stat_rx_tcp_payload_bytes, 0, memory_order_relaxed);
 }
 
 int
@@ -784,5 +786,17 @@
         *rx_packets = stat_rx_packets;
 
     if (rx_bytes)
         *rx_bytes = stat_rx_bytes;
 }
+
+void
+hev_socks5_tunnel_add_tcp_payload (size_t bytes)
+{
+    atomic_fetch_add_explicit (&stat_rx_tcp_payload_bytes, bytes, memory_order_relaxed);
+}
+
+unsigned long long
+hev_socks5_tunnel_tcp_payload_stats (void)
+{
+    return atomic_load_explicit (&stat_rx_tcp_payload_bytes, memory_order_relaxed);
+}
diff --git a/src/hev-socks5-tunnel.h b/src/hev-socks5-tunnel.h
--- a/src/hev-socks5-tunnel.h
